# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME=Healthcare Queue System

# ============================================
# Database (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_queue
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE=10000

# Connection string (alternative to individual fields)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_queue

# ============================================
# Redis (for queue state caching)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT Authentication
# ============================================
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=healthcare-queue-system

# ============================================
# Firebase Cloud Messaging
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ============================================
# SSLCommerz Payment Gateway
# ============================================
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SESSION_API=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_API=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSLCOMMERZ_SUCCESS_URL=http://localhost:5000/api/v1/payments/success
SSLCOMMERZ_FAIL_URL=http://localhost:5000/api/v1/payments/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:5000/api/v1/payments/cancel
SSLCOMMERZ_IPN_URL=http://localhost:5000/api/v1/payments/ipn

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# OTP
# ============================================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log
